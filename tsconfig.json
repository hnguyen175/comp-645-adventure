{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "rootDir": "www/ts",
    "outDir": "www/js",
    "strict": true,
    "sourceMap": true,
    "incremental": true,
    "rewriteRelativeImportExtensions": true,
    "allowUmdGlobalAccess": true,
  },
  "include": [
    "www/ts/**/*.ts",
    "www/lib/onsenui/esm/onsenui.d.ts"
  ]
}
