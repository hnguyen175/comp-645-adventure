{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "rootDir": "www/ts",
    "outDir": "www/js",
    "strict": true,
    "sourceMap": true,
    "incremental": true,
    "rewriteRelativeImportExtensions": true,
  },
  "include": ["www/ts/**/*.ts"]
}
