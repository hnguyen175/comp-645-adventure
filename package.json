{
  "name": "monaca-template-onsenui-v2-js-minimum",
  "version": "4.1.4",
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "monaca-plugin-monaca-core": "3.3.1"
  },
  "cordova": {
    "plugins": {
      "monaca-plugin-monaca-core": {}
    }
  },
  "scripts": {
    "build": "tsc --version && tsc --build --force --watch",
    "test": "vitest run --watch",
    "check": "npm run build && npm run test",
    "dev": "concurrently \"npm run build\" \"npm run serve\" \"npm run test\"",
    "monaca:transpile": "node ./node_modules/typescript/lib/tsc.js --build --force",
    "serve": "node ./node_modules/browser-sync/dist/bin.js start -s www/ --watch --port 8080 --ui-port 8081 --no-open",
    "monaca:preview": "concurrently \"npm run monaca:transpile\" \"npm run serve\"",
    "sqlite:build": "node ./scripts/copy-sqlite.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "browser-sync": "~2.27.7",
    "concurrently": "^8.2.2",
    "cordova": "^12.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-html": "^8.2.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
